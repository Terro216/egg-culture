# Canonical site: https://egg.<DOMAIN>; set before building.
DOMAIN=example.org

# Optional NewsData.io integration. Empty means no external news feed.
NEWS_API_KEY=

# Private gift section: configure your own access word and signing secret.
FONIN_ACCESS_WORD=
FONIN_GIFT_TOKEN_SECRET=
# FONIN_GIFT_PRIVATE_DIR=private/fonin-gifts

# Telegram moderation. Without both settings, posts are published immediately.
KLADKA_BOT_TOKEN=
KLADKA_ADMIN_CHAT_ID=
# Optional comma-separated moderator user IDs; otherwise chat administrators.
# KLADKA_ADMIN_USER_IDS=
# KLADKA_WEBHOOK_SECRET=
# KLADKA_IP_SALT=
# KLADKA_DATA_DIR=.kladka
# EGG_ROAD_DATA_DIR=.kladka/egg-road

# Optional legacy visibility migration: comma-separated post IDs to restrict
# when a stored entry has no explicit visibility. Keep these IDs private and
# preserve this setting with the installation's recovery configuration.
# KLADKA_LEGACY_ADEPT_POST_IDS=

# Compose SSH proxy: see docs/telegram-egress.md.
# EGG_TUNNEL_KEYS_DIR=/etc/egg-culture/tunnel
# EGG_TUNNEL_ENDPOINT_FILE=/etc/egg-culture/endpoint.json
# EGG_TUNNEL_USER=tunnel
# EGG_TUNNEL_IMAGE=egg-culture-tunnel:local
# Choose unused subnets supported by your host's routing.
# EGG_TELEGRAM_INTERNAL_SUBNET=172.28.0.0/28
# EGG_TELEGRAM_EGRESS_SUBNET=172.28.0.16/28

# Compose backup bind mounts. Worker secrets belong in .env.backup.
# EGG_BACKUP_DATA_DIR=/srv/egg-culture-backup
# EGG_BACKUP_RCLONE_DIR=/etc/egg-culture/rclone
