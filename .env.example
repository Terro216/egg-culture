# Базовый домен: сайт живет на поддомене egg.<DOMAIN>
DOMAIN=ilyamedve.dev

# Ключ NewsData.io для мировой яичной ленты в /blog.
# Без ключа лента будет пустой, остальной сайт работает.
NEWS_API_KEY=

# Кодовое слово закрытой кладки подарков (/dark-side/fonin).
# Если не задано, сервер принимает "Яй Ци".
FONIN_ACCESS_WORD=

# Секрет подписи временных HMAC-ссылок на сертификаты.
# Если не задан, используется FONIN_ACCESS_WORD — задайте отдельную длинную случайную строку.
FONIN_GIFT_TOKEN_SECRET=

# Директория с PNG-сертификатами (по умолчанию private/fonin-gifts).
# FONIN_GIFT_PRIVATE_DIR=

# ——— Книга Кладки (/kladka) ———
# Токен Telegram-бота модерации (создать у @BotFather).
# Без токена модерация выключена: записи публикуются сразу (режим разработки).
KLADKA_BOT_TOKEN=
# Ваш chat_id: напишите боту /start, затем откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите message.chat.id.
KLADKA_ADMIN_CHAT_ID=
# Секрет webhook'а (необязательно — по умолчанию производится из токена).
# KLADKA_WEBHOOK_SECRET=
# Соль хэширования IP для дневного лимита записей (по умолчанию FONIN_GIFT_TOKEN_SECRET).
# KLADKA_IP_SALT=
# Директория хранилища Книги (по умолчанию .kladka, в Docker — volume kladka_data).
# KLADKA_DATA_DIR=
