# Базовый домен: сайт живет на поддомене egg.<DOMAIN>
DOMAIN=ilyamedve.dev

# Ключ NewsData.io для мировой яичной ленты в /blog.
# Без ключа лента будет пустой, остальной сайт работает.
NEWS_API_KEY=

# Кодовое слово закрытой кладки подарков (/dark-side/fonin).
# Если не задано, сервер принимает "Яй Ци".
FONIN_ACCESS_WORD=

# Секрет подписи временных HMAC-ссылок на сертификаты.
# Если не задан, используется FONIN_ACCESS_WORD — задайте отдельную длинную случайную строку.
FONIN_GIFT_TOKEN_SECRET=

# Директория с PNG-сертификатами (по умолчанию private/fonin-gifts).
# FONIN_GIFT_PRIVATE_DIR=
