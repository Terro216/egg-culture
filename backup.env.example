# Copy to .env.backup, chmod 0600; consumed only by the backup profile.
# Values are literal (Compose env_file format: raw). Do not add shell quotes.
# Generate a separate random key, and keep a verified copy outside both hosts.
BACKUP_PASSWORD=
YANDEX_DISK_TARGET=rclone:yadisk:/backups/egg-culture
BACKUP_HOST=big-one
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=8
# Gatus external endpoint URLs (without ?success=) and their shared Bearer token.
# Provision these before enabling timers: daily 26h, weekly 192h, monthly 864h.
BACKUP_PUSH_URL=
BACKUP_PUSH_URL_WEEKLY=
BACKUP_PUSH_URL_MONTHLY=
BACKUP_PUSH_TOKEN=
