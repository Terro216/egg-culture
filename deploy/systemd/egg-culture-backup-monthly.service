[Unit]
Description=Egg Culture full backup read and restore validation
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=egg-culture
UMask=0077
WorkingDirectory=/opt/egg-culture
ExecStart=/opt/egg-culture/scripts/restic-maintenance.sh monthly
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
