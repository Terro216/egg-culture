[Unit]
Description=Egg Culture backup repository maintenance
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=egg-culture
UMask=0077
WorkingDirectory=/opt/egg-culture
ExecStart=/opt/egg-culture/scripts/restic-maintenance.sh weekly
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
