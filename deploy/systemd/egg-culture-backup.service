[Unit]
Description=Egg Culture user data offsite backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=egg-culture
UMask=0077
WorkingDirectory=/opt/egg-culture
ExecStart=/opt/egg-culture/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
