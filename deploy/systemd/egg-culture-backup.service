[Unit]
Description=Egg Culture user data offsite backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=me
UMask=0077
WorkingDirectory=/home/me/server/projects/egg-culture
ExecStart=/home/me/server/projects/egg-culture/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
