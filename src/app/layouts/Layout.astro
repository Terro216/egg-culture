---
import '@app/styles/global.css';
import Header from '@widgets/Header/Header.astro';
import Footer from '@widgets/Footer/Footer.astro';

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = "ru" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Подключение шрифтов -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --text-caps-transform: uppercase;
    --text-caps-spacing: 0.1em;
  }

  html,
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    width: 100%;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Typography Utilities */
  .text-bold {
    font-weight: 600;
    color: var(--color-text);
  }

  .text-italic {
    font-style: italic;
    color: var(--color-yolk);
  }

  .text-center {
    text-align: center;
  }

  .text-caps {
    text-transform: var(--text-caps-transform);
    letter-spacing: var(--text-caps-spacing);
  }

  .text-lead {
    font-size: 1.75rem;
    font-weight: 600;
    font-style: italic;
  }

  /* UI Components */
  .btn {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid var(--color-yolk);
    color: var(--color-text);
    font-family: var(--font-serif-headers);
    font-size: 1.2rem;
    text-transform: var(--text-caps-transform);
    letter-spacing: var(--text-caps-spacing);
    transition: all 0.3s ease;
    cursor: pointer;
    text-align: center;
  }

  .btn:hover {
    background-color: var(--color-yolk);
    color: var(--color-shell);
  }

  /* Layout Utilities */
  .flex-col {
    display: flex;
    flex-direction: column;
  }
  .gap-sm {
    gap: var(--spacing-sm);
  }
  .gap-md {
    gap: var(--spacing-md);
  }
  .gap-lg {
    gap: var(--spacing-lg);
  }
  .gap-xl {
    gap: var(--spacing-xl);
  }
  .gap-2xl {
    gap: var(--spacing-2xl);
  }
</style>
