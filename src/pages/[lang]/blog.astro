---
export const prerender = false;
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import { getCachedWorldNews } from "@shared/utils/newsCache";
import WorldNewsList from "@features/WorldNews/WorldNewsList";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;

if (lang !== "ru" && lang !== "en") {
  return Astro.redirect("/ru/blog");
}

const t = useTranslations(lang as Lang);

const worldNews = await getCachedWorldNews(lang as "ru" | "en");

const ruPosts = Object.values(import.meta.glob("../../data/blog/ru/*.md", { eager: true }));
const enPosts = Object.values(import.meta.glob("../../data/blog/en/*.md", { eager: true }));
const posts = lang === "ru" ? ruPosts : enPosts as any[];
---

<Layout title={t("blog.pageTitle")} lang={lang as string}>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 4rem; padding-bottom: 6rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{t("blog.title")}</h1>
    </div>

    <div class="tabs-container">
      <button class="tab-btn active" data-target="local-news">{lang === 'ru' ? 'Локальные статьи' : 'Local Articles'}</button>
      <button class="tab-btn" data-target="world-news">{lang === 'ru' ? 'Мировые новости' : 'World News'}</button>
    </div>

    <div id="local-news" class="blog-section tab-content">
      <div class="blog-list flex-col gap-xl">
        {
          posts.map((post) => {
            const slug = post.file.split('/').pop()?.replace('.md', '');
            return (
            <a href={`/${lang}/blog/${slug}`} class="blog-post-row">
              <div class="post-image-wrapper">
                <img
                  src={post.frontmatter.image}
                  alt={post.frontmatter.title}
                  loading="lazy"
                />
              </div>
              <div class="post-content-wrapper flex-col">
                <span class="post-date">{post.frontmatter.date}</span>
                <h2 class="post-title">{post.frontmatter.title}</h2>
                <p class="post-excerpt">{post.frontmatter.excerpt}</p>
                <span class="read-more">
                  {lang === "ru" ? "Читать полностью →" : "Read fully →"}
                </span>
              </div>
            </a>
          )})
        }
      </div>
    </div>

    <div id="world-news" class="blog-section tab-content" style="display: none;">
      <WorldNewsList client:load news={worldNews} lang={lang as "ru" | "en"} />
    </div>
  </div>
</Layout>

<style is:global>
  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk);
    padding-bottom: 2rem;
    margin: 0;
  }

  .tabs-container {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 4rem;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    border-bottom: 1px solid rgba(43, 43, 43, 0.1);
  }

  .tab-btn {
    background: none;
    border: none;
    font-family: var(--font-serif-headers);
    font-size: 1.8rem;
    color: var(--color-text);
    cursor: pointer;
    opacity: 0.4;
    transition: all 0.3s ease;
    padding: 0 1rem 1rem 1rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
  }

  .tab-btn:hover {
    opacity: 0.7;
  }

  .tab-btn.active {
    opacity: 1;
    color: var(--color-yolk);
    border-bottom: 2px solid var(--color-yolk);
  }

  .blog-list {
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
  }

  .blog-post-row {
    display: flex;
    gap: 3rem;
    text-decoration: none;
    color: inherit;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(43, 43, 43, 0.1);
    transition: opacity 0.3s ease;
  }

  .blog-post-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .blog-post-row:hover {
    opacity: 0.8;
    color: inherit;
  }

  .blog-post-row:hover .post-title {
    color: var(--color-yolk);
  }

  .post-image-wrapper {
    flex: 0 0 400px; /* Fixed width for the image */
    height: 250px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .post-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.1);
    transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .blog-post-row:hover .post-image-wrapper img {
    transform: scale(1.05);
  }

  .post-content-wrapper {
    justify-content: center;
    gap: 1rem;
    flex: 1; /* Take remaining space */
  }

  .post-date {
    font-family: var(--font-sans-ui);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .post-title {
    font-family: var(--font-serif-headers);
    font-size: 2.2rem;
    margin: 0;
    line-height: 1.1;
    color: var(--color-text); /* Use text-color for titles in blog list */
    transition: color 0.3s ease;
  }

  .post-excerpt {
    font-family: var(--font-serif-body); /* Use the new main serif font */
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Limit to 2 lines */
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    font-family: var(--font-sans-ui);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-yolk);
    padding-top: 0.5rem;
  }

  .load-more-btn {
    background: none;
    border: 1px solid var(--color-text);
    color: var(--color-text);
    font-family: var(--font-sans-ui);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 1rem 2.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0.7;
  }

  .load-more-btn:hover {
    opacity: 1;
    background: var(--color-text);
    color: var(--color-shell);
  }

  @media (max-width: 768px) {
    .blog-post-row {
      flex-direction: column;
      gap: 1.5rem;
      padding-bottom: 2rem;
    margin: 0;
    }
    .post-image-wrapper {
      flex: none;
      width: 100%;
      height: 200px;
    }
    .post-title {
      font-size: 1.8rem;
    }
    .post-content-wrapper {
      padding-left: 0;
    }
  }
</style>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active classes
      tabBtns.forEach(b => b.classList.remove('active'));
      tabContents.forEach(c => (c as HTMLElement).style.display = 'none');

      // Add active class to clicked button
      btn.classList.add('active');

      // Show corresponding content
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.style.display = 'block';
        }
      }
    });
  });
</script>
