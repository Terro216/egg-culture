---
import Layout from "../../../layouts/Layout.astro";
import i18next from "i18next";
import { blogPosts } from "../../../data/content";

export function getStaticPaths() {
  const langs = ["ru", "en"];
  return langs.flatMap((lang) =>
    blogPosts.map((post) => ({
      params: { lang, slug: post.slug },
      props: { post },
    })),
  );
}

const { lang } = Astro.params;
const { post } = Astro.props;

i18next.changeLanguage(lang as string);
---

<Layout
  title={`${post.title[lang as "ru" | "en"]} | Egg Culture`}
  lang={lang as string}
>
  <div
    class="container blog-container"
    style="padding-top: 3rem; padding-bottom: 4rem;"
  >
    <a href={`/${lang}/blog`} class="back-link">
      ← {lang === "ru" ? "Назад в Блог" : "Back to Blog"}
    </a>

    <article class="post">
      <div class="post-image-wrapper">
        <img
          src={post.image}
          alt={post.title[lang as "ru" | "en"]}
          loading="eager"
        />
      </div>
      <header class="post-header">
        <span class="post-date">{post.date}</span>
        <h1 class="post-title">{post.title[lang as "ru" | "en"]}</h1>
      </header>

      <div class="post-content" set:html={post.content[lang as "ru" | "en"]} />
    </article>
  </div>
</Layout>

<style>
  .blog-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-color);
    opacity: 0.6;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
    text-decoration: none;
  }

  .back-link:hover {
    opacity: 1;
    color: var(--accent-color);
  }

  .post-image-wrapper {
    width: 100%;
    height: 400px;
    overflow: hidden;
    margin-bottom: 3rem;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .post-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.1) brightness(0.9);
  }

  .post-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .post-date {
    display: block;
    font-family: var(--font-sans);
    font-size: 1rem;
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  .post-title {
    font-size: 3rem;
    color: var(--accent-color);
    line-height: 1.2;
    margin: 0;
  }

  .post-content {
    font-size: 1.2rem;
    line-height: 1.8;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(ul) {
    margin-bottom: 2rem;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(strong) {
    font-weight: 600;
    color: var(--accent-color);
  }
</style>
