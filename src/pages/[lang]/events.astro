---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import { eventItems } from "../../data/content";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout title={t("events.pageTitle")} lang={lang as string}>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 4rem; padding-bottom: 6rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{t("events.title")}</h1>
    </div>

    <div class="events-grid">
      {
        eventItems.map((event) => (
          <div class="event-card">
            <div class="event-card-content">
              <span class="event-date">{event.date}</span>
              <h2 class="event-title">{event.title[lang as "ru" | "en"]}</h2>
              <p class="event-location">
                📍 {event.location[lang as "ru" | "en"]}
              </p>
              <p class="event-desc">
                {event.shortDescription[lang as "ru" | "en"]}
              </p>
              <a href={`/${lang}/events/${event.slug}`} class="btn-sm">
                {lang === "ru" ? "Подробнее" : "Details"}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk);
    padding-bottom: 2rem;
    margin: 0;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .event-card {
    border: 1px solid rgba(43, 43, 43, 0.1);
    background-color: rgba(255, 255, 255, 0.5);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .event-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-yolk);
  }

  .event-card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }

  .event-date {
    font-family: var(--font-sans-ui);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-yolk);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 1rem;
  }

  .event-title {
    font-size: 1.8rem;
    padding: 0 0 1rem 0;
    line-height: 1.3;
  }

  .event-location {
    font-family: var(--font-sans-ui);
    font-size: 0.95rem;
    opacity: 0.8;
    padding: 0 0 1.5rem 0;
  }

  .event-desc {
    font-size: 1.1rem;
    opacity: 0.8;
    padding: 0 0 2rem 0;
    flex-grow: 1;
    line-height: 1.6;
  }

  .btn-sm {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-yolk);
    color: var(--color-text);
    font-family: var(--font-sans-ui);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.3s ease;
    text-align: center;
  }

  .btn-sm:hover {
    background-color: var(--color-yolk);
    color: var(--color-shell);
  }
</style>
