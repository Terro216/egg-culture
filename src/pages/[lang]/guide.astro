---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import QiCompass from '@features/QiCompass/QiCompass';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);

const guideContent = {
  ru: {
    title: "Справочник Адепта Яичной Культуры",
    intro: "Этот справочник — фундамент вашего языка. Без него опыт остается немым. Изучите его, чтобы отличать «пустоту» от «деликатности» и уметь описать «амплитуду желтка» в приличном обществе. Культура жива, пока мы придумываем новые слова для описания вечного.",
    sections: [
      {
        title: "I. Морфология и Анатомия (Термины Формы)",
        items: [
          { id: "dome", name: "Купол (The Dome)", desc: "Центральная, возвышающаяся часть желтка. У молодых, «сильных» яиц купол высокий и упругий. Пологий купол говорит об ослаблении структуры и зрелом возрасте партии." },
          { id: "albumin-cloud", name: "Альбуминовое Облако (The Albumin Cloud)", desc: "Плотный слой белка, непосредственно окружающий желток. В идеальном яйце он должен быть четко очерчен, напоминая ореол." },
          { id: "outer-terrace", name: "Внешняя Терраса", desc: "Жидкий, периферийный слой белка. Его избыток часто свидетельствует о «водянистости» профиля." },
          { id: "chalaza", name: "Халаза (Якорная цепь)", desc: "Белковые канатики, удерживающие желток. Адепты ценят выраженную халазу как признак «витальной собранности» продукта." },
          { id: "air-cell", name: "Воздушная Камера (Пуга)", desc: "Пространство на тупом конце яйца. Воздушная камера увеличивается по мере выдержки и служит главным ориентиром возрастной категории." }
        ]
      },
      {
        title: "II. Энергетика и Воздействие (Яй Ци)",
        items: [
          { id: "egg-qi", name: "Яй Ци (Egg Qi)", desc: "Интегральное воздействие яйца, не сводимое к сумме вкуса, аромата и текстуры; телесный вектор, проявляющийся в дыхании, осанке и темпе мысли." },
          { id: "verticality", name: "Вертикаль", desc: "Состояние, когда после дегустации ощущается ясность взора и выпрямление осанки (характерно для свежих белых яиц)." },
          { id: "grounding", name: "Заземление", desc: "Ощущение телесного покоя и тяжести, приходящее от плотных, «бульонных» желтков." },
          { id: "vibration", name: "Вибрация", desc: "Легкое сернистое покалывание на языке, указывающее на «дикий» характер партии." },
          { id: "void", name: "Пустота (The Void)", desc: "Технически безупречное яйцо, которое не оставляет в сознании никакого следа. Гастрономический тупик." }
        ]
      },
      {
        title: "III. Глоссарий Дегустации (Процесс)",
        items: [
          { id: "attack", name: "Атака", desc: "Первое впечатление в момент соприкосновения желтка с небом. Бывает «сливочной», «агрессивной» или «минеральной»." },
          { id: "body", name: "Тело (Body)", desc: "Плотность и вязкость текстуры. Легкое тело напоминает нежирные сливки или рисовый отвар; среднее — шелковистое, обволакивающее; плотное — пастозное, заставляющее рецепторы работать на пределе." },
          { id: "development", name: "Развитие", desc: "То, как вкус меняется во рту в течение первых 5–10 секунд." },
          { id: "finish", name: "Финиш (Послевкусие)", desc: "Шлейф, остающийся после глотка. Бывает коротким и прямым либо долгим, почти «километровым»." },
          { id: "chalky-trail", name: "Меловой след", desc: "Специфическое ощущение сухости после белка, в котором раскрывается его минеральный профиль." }
        ]
      },
      {
        title: "IV. Классификация по Происхождению (Терруар)",
        items: [
          { id: "industrial-stream", name: "Индустриальный Стрим (Mass Market)", desc: "Яйца с предсказуемым, «чистым», но часто плоским вкусом. Используются как база для калибровки рецепторов." },
          { id: "farm-concept", name: "Фермерский Концепт", desc: "Яйца с акцентом на зерновой прикорм (кукуруза, пшеница). Яркие, понятные, «желтые»." },
          { id: "yard-wild", name: "Дворовый Дикий (Yard Wild)", desc: "Высшая степень непредсказуемости. Ноты пера, сена, червей. Требуют высокого уровня подготовки." },
          { id: "micro-batch", name: "Микролот (Micro-batch)", desc: "Партия от одной конкретной группы кур в определенный промежуток времени (например, «ранний майский сбор в такой-то локации»)." }
        ]
      },
      {
        title: "V. Стилистические Категории (Стили)",
        items: [
          { id: "blanc-style", name: "Светлый Стиль (Blanc)", desc: "Доминанта белка, чистоты, мела и воды. Интеллигентные яйца для утренних медитаций." },
          { id: "bouillon-style", name: "Бульонный Стиль (Bouillon)", desc: "Высокая концентрация умами, животные и мясные ноты. Зимние, «тяжелые» яйца." },
          { id: "pastoral-style", name: "Пасторальный Стиль", desc: "Акцент на сливки, траву и свежее масло. Гедонистический профиль." },
          { id: "aged-style", name: "Архивный Стиль (Aged)", desc: "Яйца выдержки 21+ день при непрерывном холодном хранении. Сложные ноты погреба, старой бумаги и глубокой сернистости." }
        ]
      },
      {
        title: "VI. Дефектология (Словарь Ошибок)",
        items: [
          { id: "refrigerator-burn", name: "Холодильный Ожог", desc: "Затхлый, «пластиковый» привкус, убивающий терруар." },
          { id: "fishy-shadow", name: "Рыбная Тень", desc: "Устойчивый рыбный оттенок, связанный с особенностями прикорма. Считается грубым дефектом, лишающим яйцо благородства." },
          { id: "cardboard-finish", name: "Картонный Финиш", desc: "Сухость без минеральности, признак старого, «умершего» белка." },
          { id: "iodine-anxiety", name: "Йодистая Тревога", desc: "Резкий аптечный привкус, нарушающий чистоту финиша." }
        ]
      },
      {
        title: "VII. Инструментарий и Этикет",
        items: [
          { id: "temperature-pause", name: "Температурная Пауза", desc: "20-минутное ожидание, пока яйцо согревается до комнатной температуры после извлечения из хранилища." },
          { id: "aeration", name: "Аэрация", desc: "Вскрытие желтка и легкое перемешивание с белком (в некоторых школах считается варварством, в других — способом «разбудить» аромат)." },
          { id: "blind-meeting", name: "Слепая Встреча", desc: "Дегустация без знания бренда и цены, единственный способ честной оценки Яй Ци." }
        ]
      },
      {
        title: "Таблица Ментальных Состояний (Для записи в дневник)",
        items: [
          { id: "ringing", name: "Звонкое", desc: "Очень свежее, с высокой кислотностью и минеральностью. Пример: \"Это белое яйцо сегодня удивительно звонкое\"." },
          { id: "composed", name: "Собранное", desc: "Идеальный баланс между текстурой белка и жирностью желтка. Пример: \"Партия на 14-й день наконец-то стала собранной\"." },
          { id: "nervous", name: "Нервное", desc: "Неровный вкус, перепады от сладости к металлу. Пример: \"Партия из Крыма в этот раз какая-то нервная\"." },
          { id: "dusty", name: "Пыльное", desc: "Легкая землистая нота в послевкусии. Пример: \"В финише чувствуется приятная пыльность старого сена\"." }
        ]
      }
    ]
  },
  en: {
    title: "Adept's Guide to Egg Culture",
    intro: "This guide is the foundation of your language. Without it, the experience remains mute. Study it to distinguish 'emptiness' from 'delicacy' and be able to describe the 'yolk amplitude' in polite society. Culture lives as long as we invent new words to describe the eternal.",
    sections: [
      {
        title: "I. Morphology and Anatomy (Terms of Form)",
        items: [
          { id: "dome", name: "The Dome", desc: "The central, elevated part of the yolk. In young, 'strong' eggs, the dome is high and resilient. A gentle dome indicates structural weakening and a mature batch." },
          { id: "albumin-cloud", name: "The Albumin Cloud", desc: "The dense layer of egg white immediately surrounding the yolk. In a perfect egg, it should be clearly defined, resembling a halo." },
          { id: "outer-terrace", name: "Outer Terrace", desc: "The liquid, peripheral layer of the egg white. Its excess often indicates a 'watery' profile." },
          { id: "chalaza", name: "Chalaza (Anchor Chain)", desc: "Protein cords holding the yolk. Adepts value a pronounced chalaza as a sign of the product's 'vital composure'." },
          { id: "air-cell", name: "Air Cell", desc: "The space at the blunt end of the egg. The air cell expands as the egg ages and serves as the primary guide to its age category." }
        ]
      },
      {
        title: "II. Energy and Impact (Egg Qi)",
        items: [
          { id: "egg-qi", name: "Egg Qi", desc: "The egg's integral effect, irreducible to the sum of flavor, aroma, and texture; a bodily vector manifest in breath, posture, and the pace of thought." },
          { id: "verticality", name: "Verticality", desc: "A state when, after tasting, one feels clarity of vision and straightening of posture (typical for fresh white eggs)." },
          { id: "grounding", name: "Grounding", desc: "A feeling of physical peace and heaviness coming from dense, 'brothy' yolks." },
          { id: "vibration", name: "Vibration", desc: "A slight sulfurous tingling on the tongue, indicating the 'wild' character of the batch." },
          { id: "void", name: "The Void", desc: "A technically flawless egg that leaves no trace in consciousness. A gastronomic dead end." }
        ]
      },
      {
        title: "III. Tasting Glossary (Process)",
        items: [
          { id: "attack", name: "Attack", desc: "The first impression at the moment the yolk touches the palate. It can be 'creamy', 'aggressive', or 'mineral'." },
          { id: "body", name: "Body", desc: "The density and viscosity of the texture. A light body resembles low-fat cream or rice water; medium is silky, enveloping; heavy is pasty, forcing receptors to work at their limit." },
          { id: "development", name: "Development", desc: "How the taste changes in the mouth during the first 5-10 seconds." },
          { id: "finish", name: "Finish (Aftertaste)", desc: "The trail left after swallowing. It can be short and direct or long, almost 'kilometer-long'." },
          { id: "chalky-trail", name: "Chalky Trail", desc: "A distinctive dryness after the egg white, through which its mineral profile reveals itself." }
        ]
      },
      {
        title: "IV. Classification by Origin (Terroir)",
        items: [
          { id: "industrial-stream", name: "Industrial Stream (Mass Market)", desc: "Eggs with a predictable, 'clean', but often flat taste. Used as a base for receptor calibration." },
          { id: "farm-concept", name: "Farm Concept", desc: "Eggs with an emphasis on grain feed (corn, wheat). Bright, approachable, 'yellow'." },
          { id: "yard-wild", name: "Yard Wild", desc: "The highest degree of unpredictability. Notes of feather, hay, worms. Require a high level of preparation." },
          { id: "micro-batch", name: "Micro-batch", desc: "A batch from one specific group of hens in a certain period of time (e.g., 'early May collection in such and such a location')." }
        ]
      },
      {
        title: "V. Stylistic Categories (Styles)",
        items: [
          { id: "blanc-style", name: "Blanc Style (Light)", desc: "Dominance of egg white, purity, chalk, and water. Intelligent eggs for morning meditations." },
          { id: "bouillon-style", name: "Bouillon Style (Broth)", desc: "High concentration of umami, animal and meat notes. Winter, 'heavy' eggs." },
          { id: "pastoral-style", name: "Pastoral Style", desc: "Emphasis on cream, grass, and fresh butter. A hedonistic profile." },
          { id: "aged-style", name: "Aged (Archive) Style", desc: "Eggs aged 21+ days under continuous cold storage. Complex notes of cellar, old paper, and deep sulfur." }
        ]
      },
      {
        title: "VI. Defectology (Dictionary of Errors)",
        items: [
          { id: "refrigerator-burn", name: "Freezer Burn", desc: "A musty, 'plastic' aftertaste that kills the terroir." },
          { id: "fishy-shadow", name: "Fishy Shadow", desc: "A persistent fishy note associated with the particulars of the hen's feed. Considered a gross defect, depriving the egg of nobility." },
          { id: "cardboard-finish", name: "Cardboard Finish", desc: "Dryness without minerality, a sign of an old, 'dead' egg white." },
          { id: "iodine-anxiety", name: "Iodine Anxiety", desc: "A sharp medicinal note that disrupts the purity of the finish." }
        ]
      },
      {
        title: "VII. Tools and Etiquette",
        items: [
          { id: "temperature-pause", name: "Temperature Pause", desc: "A 20-minute wait while the egg warms to room temperature after removal from storage." },
          { id: "aeration", name: "Aeration", desc: "Opening the yolk and lightly mixing it with the white (considered barbarism in some schools, in others - a way to 'wake up' the aroma)." },
          { id: "blind-meeting", name: "Blind Meeting", desc: "Tasting without knowing the brand and price, the only way to honestly evaluate Egg Qi." }
        ]
      },
      {
        title: "Table of Mental States (For diary entries)",
        items: [
          { id: "ringing", name: "Ringing", desc: "Very fresh, with high acidity and minerality. Example: \"This white egg today is surprisingly ringing\"." },
          { id: "composed", name: "Composed", desc: "A perfect balance between the texture of the white and the fatness of the yolk. Example: \"The batch on the 14th day finally became composed\"." },
          { id: "nervous", name: "Nervous", desc: "Uneven taste, swings from sweetness to metal. Example: \"The batch from Crimea this time is somehow nervous\"." },
          { id: "dusty", name: "Dusty", desc: "A light earthy note in the aftertaste. Example: \"In the finish, you can feel the pleasant dustiness of old hay\"." }
        ]
      }
    ]
  }
};

const content = guideContent[lang as "ru" | "en"];

const compassSection = {
  ru: {
    title: "Компас Яй Ци",
    intro:
      "Всякий стиль занимает свое место между минеральностью и животностью, легкостью и плотностью. Пустота — в начале координат.",
  },
  en: {
    title: "The Egg Qi Compass",
    intro:
      "Every style occupies its place between minerality and animality, lightness and density. The Void sits at the origin.",
  },
}[lang as "ru" | "en"];

const getSlug = (text: string) => text.toLowerCase().replace(/[^a-z0-9а-яё]/gi, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
---

<Layout
  title={`${content.title} | Egg Culture`}
  description={content.intro}
  lang={lang as string}
>
  <div class="guide-layout">
    <nav class="guide-toc">
      <div class="toc-sticky">
        <ul class="toc-list">
          {
            content.sections.map((section) => (
              <li>
                <a href={`#${getSlug(section.title)}`}>{section.title}</a>
              </li>
            ))
          }
          <li>
            <a href="#qi-compass">{compassSection.title}</a>
          </li>
        </ul>
      </div>
    </nav>
    <div
      class="container guide-container"
      style="padding-top: 3rem; padding-bottom: 4rem;"
    >
    <header class="text-center flex-col gap-sm" style="padding-bottom: 4rem;">
      <h1 class="page-title">{content.title}</h1>
      <p class="text-lead" style="max-width: 800px; margin: 0 auto; line-height: 1.6;">
        {content.intro}
      </p>
    </header>

    <article class="guide-content">
      {
        content.sections.map((section) => (
          <>
            <h2 id={getSlug(section.title)}>
              <a href={`#${getSlug(section.title)}`} class="heading-anchor">#</a>
              {section.title}
            </h2>
            <dl class="term-list" style="padding-bottom: 4rem;">
              {
                section.items.map((item) => (
                  <div class="term-item" id={item.id}>
                    <dt><a href={`#${item.id}`}>{item.name}</a></dt>
                    <dd>{item.desc}</dd>
                  </div>
                ))
              }
            </dl>
          </>
        ))
      }

      <h2 id="qi-compass">
        <a href="#qi-compass" class="heading-anchor">#</a>
        {compassSection.title}
      </h2>
      <p class="text-lead" style="padding-top: 1.5rem; line-height: 1.6;">
        {compassSection.intro}
      </p>
      <div style="padding-top: 2rem; padding-bottom: 4rem;">
        <QiCompass client:visible lang={lang as "ru" | "en"} />
      </div>

      <p class="text-center" style="padding-bottom: 4rem;">
        <a href={`/${lang}/vintages`} class="btn">
          {lang === "ru" ? "Сезонность Партий: Винтажи →" : "Seasonality of Batches: Vintages →"}
        </a>
      </p>
    </article>
    </div>
  </div>
</Layout>

<script>
  const setupObserver = () => {
    const headings = document.querySelectorAll('.guide-content h2');
    if (!headings.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          document.querySelectorAll('.toc-list a').forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('active');
            }
          });
        }
      });
    }, { rootMargin: '-15% 0px -80% 0px' });

    headings.forEach((h2) => {
      observer.observe(h2);
    });
  };

  setupObserver();
  document.addEventListener('astro:page-load', setupObserver);
</script>

<style>
  .guide-layout {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    padding: 0 2rem;
    gap: 4rem;
  }

  .guide-toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .guide-toc {
      display: block;
      width: 250px;
      flex-shrink: 0;
      padding-top: 3rem;
    }
  }

  .toc-sticky {
    position: sticky;
    top: 6rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .toc-list a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    opacity: 0.6;
    transition: all 0.2s;
    line-height: 1.4;
    display: block;
  }

  .toc-list a:hover,
  .toc-list a.active {
    opacity: 1;
    color: var(--color-yolk);
  }

  .toc-list a.active {
    font-weight: 600;
    transform: translateX(4px);
  }

  .heading-anchor {
    position: absolute;
    left: -1.5rem;
    opacity: 0;
    color: var(--color-yolk);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  h2:hover .heading-anchor {
    opacity: 1;
  }

  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk);
    padding-bottom: 2rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    .guide-layout {
      padding: 0 1rem;
      gap: 2rem;
    }
  }

  .guide-container {
    max-width: 800px;
    margin: 0;
    flex-grow: 1;
  }

  .guide-content h2 {
    font-size: 2rem;
    color: var(--color-yolk);
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(43, 43, 43, 0.1);
    font-family: var(--font-serif-headers);
    position: relative;
    scroll-margin-top: 6rem;
  }

  .term-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 2rem;
    margin: 0;
  }

  .term-item {
    background-color: rgba(255, 255, 255, 0.3);
    padding: 2rem;
    border: 1px solid rgba(43, 43, 43, 0.1);
    border-radius: 4px;
    scroll-margin-top: 2rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .term-item:target {
    border-color: var(--color-yolk);
    background-color: rgba(212, 175, 55, 0.08);
  }

  .term-item dt {
    font-family: var(--font-serif-headers);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-yolk);
    padding-bottom: 0.75rem;
  }

  .term-item dd {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.8;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .term-item {
      padding: 1rem;
    }
    .term-item dt {
      font-size: 1.25rem;
    }
    .term-item dd {
      font-size: 1rem;
    }
  }
</style>
