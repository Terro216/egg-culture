---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import MonumentalEgg from '@shared/ui/MonumentalEgg/MonumentalEgg.astro';
import { TerroirMap } from '@features/TerroirMap/TerroirMap';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout title={t("home.pageTitle")} lang={lang as string}>
  <div class="container hero text-center">
    <div class="hero-content flex-col gap-lg">
      <h1>{t("home.heroTitle")}</h1>
      <MonumentalEgg />
      <p>{t("home.heroSubtitle")}</p>
      <div style="padding-bottom: 2rem;">
        <a href={`/${lang}/manifesto`} class="btn"
          >{t("home.readManifesto")}</a
        >
      </div>
    </div>
  </div>
  <div class="container">
    <TerroirMap client:visible dict={t("terroir")} />
  </div>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-content {
    max-width: 600px;
  }

  h1 {
    font-size: 4rem;
    color: var(--color-yolk);
  }

  p {
    font-size: 1.5rem;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 1.125rem;
    }

    .hero {
      min-height: auto;
      padding: 2rem 1rem;
    }
  }
</style>
