---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import MonumentalEgg from '@shared/ui/MonumentalEgg/MonumentalEgg.astro';
import { TerroirMap } from '@features/TerroirMap/TerroirMap';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout
  title={t("home.pageTitle")}
  description={t("home.metaDescription")}
  lang={lang as string}
>
  <div class="container hero text-center">
    <div class="hero-content flex-col gap-lg">
      <h1>{t("home.heroTitle")}</h1>
      <MonumentalEgg />
      <p>{t("home.heroSubtitle")}</p>
      <div class="hero-actions">
        <a href={`/${lang}/manifesto`} class="btn">{t("home.readManifesto")}</a>
        <div class="hero-practices">
          <a href={`/${lang}/tools#calculator`}>{t("home.boilFirst")} →</a>
          <span aria-hidden="true">·</span>
          <a href={`/${lang}/tools#oracle`}>{t("home.askOracle")} →</a>
        </div>
        <a href={`/${lang}/play/`} class="hero-play">{t("home.playRoad")} →</a>
      </div>
    </div>
  </div>
  <div class="container">
    <TerroirMap client:visible lang={lang as Lang} dict={t("terroir")} />
  </div>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-content {
    max-width: 600px;
  }

  h1 {
    font-size: 4rem;
    color: var(--color-yolk);
  }

  p {
    font-size: 1.5rem;
    opacity: 0.9;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .hero-practices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-sans-ui);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
  }

  .hero-practices a {
    border-bottom: 1px solid rgba(43, 43, 43, 0.35);
  }

  .hero-practices span {
    opacity: 0.45;
  }

  .hero-play {
    margin-top: .25rem;
    padding: .8rem 1.3rem;
    border: 1px solid var(--color-yolk);
    border-radius: 3px 16px 3px 16px;
    font: .9rem var(--font-sans-ui);
    background: #d4af3710;
  }
  .hero-play:hover { background: #d4af3728; }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 1.125rem;
    }

    .hero {
      min-height: auto;
      padding: 2rem 1rem;
    }
  }
</style>
