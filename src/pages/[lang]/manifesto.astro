---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout title={t("manifesto.pageTitle")} lang={lang as string}>
  <div class="container">
    <article class="manifesto">
      <h1>{t("manifesto.title")}</h1>

      <p class="lead">{t("manifesto.lead")}</p>

      <p>{t("manifesto.p1")}</p>
      <p>{t("manifesto.p2")}</p>
      <p>{t("manifesto.p3")}</p>

      <p set:html={t("manifesto.p4")} />

      <p class="text-bold">{t("manifesto.p5")}</p>

      <p set:html={t("manifesto.p6")} />

      <h2>{t("manifesto.h_affirm")}</h2>
      <p set:html={t("manifesto.p7")} />

      <p set:html={t("manifesto.p8")} />

      <h2>{t("manifesto.h_subtlety")}</h2>

      <p set:html={t("manifesto.p9")} />

      <p set:html={t("manifesto.p10")} />

      <h2>{t("manifesto.h_reject")}</h2>

      <p set:html={t("manifesto.p11")} />

      <p class="text-bold">{t("manifesto.p12")}</p>

      <p set:html={t("manifesto.p13")} />

      <p set:html={t("manifesto.p14")} />

      <h2>{t("manifesto.h_discipline")}</h2>

      <p>{t("manifesto.p15")}</p>
      <ul>
        <li>{t("manifesto.li1")}</li>
        <li>{t("manifesto.li2")}</li>
        <li>{t("manifesto.li3")}</li>
        <li>{t("manifesto.li4")}</li>
        <li>{t("manifesto.li5")}</li>
        <li>{t("manifesto.li6")}</li>
        <li>{t("manifesto.li7")}</li>
      </ul>

      <h2>{t("manifesto.h_origin")}</h2>

      <p set:html={t("manifesto.p16")} />

      <p set:html={t("manifesto.p17")} />

      <p set:html={t("manifesto.p18")} />

      <h2>{t("manifesto.h_vulgarity")}</h2>

      <p set:html={t("manifesto.p19")} />

      <p class="text-bold" set:html={t("manifesto.p20")} />

      <p set:html={t("manifesto.p21")} />

      <p set:html={t("manifesto.p22")} />

      <p set:html={t("manifesto.p23")} />

      <p set:html={t("manifesto.p24")} />

      <p>{t("manifesto.p25")}</p>

      <p class="finale">{t("manifesto.finale")}</p>
    </article>
  </div>
</Layout>

<style>
  .manifesto {
    max-width: 800px;
    margin: 0 auto; padding-top: 4rem; padding-bottom: 4rem;
    padding: 0 1rem;
  }

  h1 {
    font-size: 3.5rem;
    text-align: center;
    padding-bottom: 3rem;
    color: var(--color-yolk);
  }

  h2 {
    font-size: 2rem;
    padding-top: 3rem;
    padding-bottom: 1.5rem;
    color: var(--color-text);
  }

  p {
    font-size: 1.25rem;
    padding-bottom: 1.5rem;
    line-height: 1.8;
  }

  .lead {
    font-size: 1.75rem;
    font-weight: 600;
    text-align: center;
    padding-bottom: 3rem;
    font-style: italic;
  }

  ul {
    font-size: 1.25rem;
    line-height: 1.8;
    padding-bottom: 2rem;
    list-style-type: none;
    padding-left: 2rem;
  }

  ul li {
    padding-bottom: 0.5rem;
    position: relative;
  }

  ul li::before {
    content: "•";
    color: var(--color-yolk);
    position: absolute;
    left: -1.5rem;
  }

  .finale {
    font-size: 1.5rem;
    text-align: center;
    padding-top: 4rem;
    font-weight: 600;
    text-transform: var(--text-caps-transform);
    letter-spacing: var(--text-caps-spacing);
  }

  @media (max-width: 768px) {
    .manifesto {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    h1 {
      font-size: 2rem;
      padding-bottom: 1.5rem;
    }

    h2 {
      font-size: 1.5rem;
      padding-top: 1.5rem;
      padding-bottom: 1rem;
    }

    p, ul {
      font-size: 1rem;
    }

    .lead {
      font-size: 1.25rem;
      padding-bottom: 1.5rem;
    }

    .finale {
      font-size: 1.125rem;
      padding-top: 2rem;
    }
  }
</style>
