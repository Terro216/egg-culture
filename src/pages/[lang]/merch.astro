---
import Layout from "../../layouts/Layout.astro";
import i18next from "i18next";
import { merchItems } from "../../data/content";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
i18next.changeLanguage(lang as string);
---

<Layout title={i18next.t("merch.pageTitle")} lang={lang as string}>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 4rem; padding-bottom: 6rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{i18next.t("merch.title")}</h1>
    </div>

    <div class="merch-gallery">
      {
        merchItems.map((item) => (
          <a href={`/${lang}/merch/${item.slug}`} class="merch-card">
            <div class="merch-image-wrapper">
              <img
                src={item.image}
                alt={item.title[lang as "ru" | "en"]}
                loading="lazy"
              />
            </div>
            <div class="merch-info flex-col gap-sm">
              <h2 class="merch-title">{item.title[lang as "ru" | "en"]}</h2>
              <p class="merch-subtitle">
                {item.shortDescription[lang as "ru" | "en"]}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .page-title {
    font-size: 3.5rem;
    color: var(--accent-color);
    padding-bottom: 2rem;
  }

  .merch-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
  }

  .merch-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .merch-card:hover {
    transform: translateY(-8px);
    opacity: 0.9;
  }

  .merch-image-wrapper {
    width: 100%;
    height: 400px; /* Adjust height as needed */
    overflow: hidden;
    padding-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    background-color: rgba(0, 0, 0, 0.05);
  }

  .merch-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.1) brightness(0.9);
    transition:
      filter 0.5s ease,
      transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .merch-card:hover .merch-image-wrapper img {
    filter: grayscale(0) brightness(1);
    transform: scale(1.03);
  }

  .merch-info {
    text-align: center;
  }

  .merch-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--accent-color);
    margin: 0;
    line-height: 1.2;
  }

  .merch-subtitle {
    font-size: 1.1rem;
    opacity: 0.8;
    margin: 0;
  }

  @media (max-width: 768px) {
    .merch-gallery {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .merch-image-wrapper {
      height: 300px;
    }
    .merch-title {
      font-size: 1.8rem;
    }
  }
</style>
