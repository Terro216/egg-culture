---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from "@app/layouts/Layout.astro";
import { merchItems } from "../../../data/content";

export function getStaticPaths() {
  const langs = ["ru", "en"];
  return langs.flatMap((lang) =>
    merchItems.map((item) => ({
      params: { lang, slug: item.slug },
      props: { item },
    })),
  );
}

const { lang } = Astro.params;
const { item } = Astro.props;

const t = useTranslations(lang as Lang);
---

<Layout
  title={`${item.title[lang as "ru" | "en"]} | Egg Culture`}
  lang={lang as string}
>
  <div
    class="container merch-container"
    style="padding-top: 3rem; padding-bottom: 4rem;"
  >
    <a href={`/${lang}/merch`} class="back-link">
      ← {lang === "ru" ? "Назад в Бутик" : "Back to Boutique"}
    </a>

    <article class="merch-detail">
      <div class="merch-image-wrapper">
        <img
          src={item.image}
          alt={item.title[lang as "ru" | "en"]}
          loading="eager"
        />
      </div>
      <header class="merch-header">
        <h1 class="merch-title">{item.title[lang as "ru" | "en"]}</h1>
        <p class="merch-price">{item.price}</p>
      </header>

      <div class="merch-content">
        <p>{item.description[lang as "ru" | "en"]}</p>
      </div>

      <div class="merch-action">
        <a
          href="https://t.me/+QIepC6ildbdmMDBi"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
        >
          {lang === "ru" ? "Заказать в Telegram" : "Order via Telegram"}
        </a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .merch-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    padding-bottom: 2rem;
    font-family: var(--font-sans-ui);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    opacity: 0.6;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
    text-decoration: none;
  }

  .back-link:hover {
    opacity: 1;
    color: var(--color-yolk);
  }

  .merch-detail {
    border: 1px solid rgba(43, 43, 43, 0.1);
    background-color: rgba(255, 255, 255, 0.5);
    padding: 3rem;
  }

  .merch-image-wrapper {
    width: calc(100% + 6rem);
    margin: -3rem -3rem 3rem -3rem;
    height: 400px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .merch-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.1) brightness(0.9);
  }

  .merch-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(43, 43, 43, 0.1);
    padding-bottom: 2rem;
    text-align: center;
  }

  .merch-title {
    font-size: 3rem;
    color: var(--color-yolk);
    line-height: 1.2;
    padding: 0 0 1rem 0;
  }

  .merch-price {
    font-family: var(--font-sans-ui);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .merch-content {
    font-size: 1.2rem;
    line-height: 1.8;
    padding-bottom: 3rem;
  }

  .merch-action {
    text-align: center;
  }
</style>
