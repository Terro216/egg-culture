---
import Layout from '@app/layouts/Layout.astro';
import { Quiz } from '@features/Quiz/Quiz';
import { getLangFromUrl } from '@shared/i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } },
  ];
}

const lang = getLangFromUrl(Astro.url);

const ui = {
  ru: {
    pageTitle: "Инициация | Яичная Культура",
    description: "Проверьте свою приверженность",
    title: "Инициация Адепта",
  },
  en: {
    pageTitle: "Initiation | Egg Culture",
    description: "Test your devotion",
    title: "Initiation of the Adept",
  },
}[lang];
---

<Layout title={ui.pageTitle} description={ui.description} lang={lang} noindex>
  <main class="quiz-page">
    <div class="container">
      <h1 class="page-title">{ui.title}</h1>
      {lang === 'ru' && (
        <div class="quiz-intro">
          <p>
            Инициация даёт вам звание Истинного Адепта и открывает Тёмную Сторону Яйца — закрытый раздел с тайными анонсами и приглашениями для посвящённых. Вы сможете оформить и скачать именной сертификат с печатью Ордена Яйца, а ещё — оставлять записи и фотографии в Книге Кладки, общей летописи адептов.
          </p>
          <p>
            У ваших рассуждений о характере желтка появится документальное основание, а у завтраков — место в истории. Что ждёт за красным занавесом, здесь раскрывать не принято. Скажем лишь одно: скорлупа всё это время скрывала больше, чем желток.
          </p>
        </div>
      )}
      <Quiz lang={lang} client:load />
    </div>
  </main>
</Layout>

<style>
  .quiz-page {
    padding: 4rem 0;
  }

  .page-title {
    text-align: center;
    font-family: var(--font-serif-headers, 'Playfair Display', serif);
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--color-text, #2b2b2b);
  }

  .quiz-intro {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .quiz-intro p + p {
    margin-top: 1rem;
  }
</style>
