---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import { shopItems } from "../../data/content";
import ShopImage from '@shared/ui/ShopImage/ShopImage.astro';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout
  title={t("shop.pageTitle")}
  description={t("shop.metaDescription")}
  lang={lang as string}
>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 4rem; padding-bottom: 6rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{t("shop.title")}</h1>
    </div>

    <div class="shop-gallery">
      {
        shopItems.map((item, index) => (
          <a href={`/${lang}/shop/${item.slug}`} class="shop-card">
            <div class="shop-image-wrapper">
              <ShopImage
                src={item.image}
                alt={item.title[lang as "ru" | "en"]}
                lang={lang as string}
                eager={index < 3}
                priority={index === 0}
                sizes="(max-width: 639px) calc(100vw - 2rem), (max-width: 991px) calc((100vw - 5rem) / 2), 350px"
              />
            </div>
            <div class="shop-info flex-col gap-sm">
              <h2 class="shop-title">{item.title[lang as "ru" | "en"]}</h2>
              <p class="shop-subtitle">
                {item.shortDescription[lang as "ru" | "en"]}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk-text);
    padding-bottom: 2rem;
    margin: 0;
  }

  .shop-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 3rem;
  }

  .shop-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .shop-card:hover {
    transform: translateY(-4px);
    opacity: 0.9;
  }

  .shop-card:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 6px;
  }

  .shop-image-wrapper {
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid rgba(43, 43, 43, 0.1);
    background-color: rgba(0, 0, 0, 0.05);
  }

  .shop-image-wrapper :global(.shop-photo) {
    filter: grayscale(0.1) brightness(0.9);
    transition: filter 0.5s ease;
  }

  .shop-card:hover .shop-image-wrapper :global(.shop-photo) {
    filter: grayscale(0) brightness(1);
  }

  .shop-info {
    text-align: center;
  }

  .shop-title {
    font-family: var(--font-serif-headers);
    font-size: 2.2rem;
    color: var(--color-yolk-text);
    margin: 0;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .shop-subtitle {
    font-size: 1.1rem;
    opacity: 0.8;
    margin: 0;
  }

  @media (max-width: 768px) {
    .shop-gallery {
      gap: 2rem;
    }
    .shop-title {
      font-size: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-card,
    .shop-image-wrapper :global(.shop-photo) {
      transition: none;
    }
    .shop-card:hover {
      transform: none;
    }
  }
</style>
