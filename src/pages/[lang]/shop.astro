---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import { shopItems } from "../../data/content";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout title={t("shop.pageTitle")} lang={lang as string}>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 4rem; padding-bottom: 6rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{t("shop.title")}</h1>
    </div>

    <div class="shop-gallery">
      {
        shopItems.map((item) => (
          <a href={`/${lang}/shop/${item.slug}`} class="shop-card">
            <div class="shop-image-wrapper">
              <img
                src={item.image}
                alt={item.title[lang as "ru" | "en"]}
                loading="lazy"
              />
            </div>
            <div class="shop-info flex-col gap-sm">
              <h2 class="shop-title">{item.title[lang as "ru" | "en"]}</h2>
              <p class="shop-subtitle">
                {item.shortDescription[lang as "ru" | "en"]}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk);
    padding-bottom: 2rem;
    margin: 0;
  }

  .shop-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
  }

  .shop-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .shop-card:hover {
    transform: translateY(-8px);
    opacity: 0.9;
  }

  .shop-image-wrapper {
    width: 100%;
    height: 400px; /* Adjust height as needed */
    overflow: hidden;
    padding-bottom: 1.5rem;
    border: 1px solid rgba(43, 43, 43, 0.1);
    background-color: rgba(0, 0, 0, 0.05);
  }

  .shop-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.1) brightness(0.9);
    transition:
      filter 0.5s ease,
      transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .shop-card:hover .shop-image-wrapper img {
    filter: grayscale(0) brightness(1);
    transform: scale(1.03);
  }

  .shop-info {
    text-align: center;
  }

  .shop-title {
    font-family: var(--font-serif-headers);
    font-size: 2.2rem;
    color: var(--color-yolk);
    margin: 0;
    line-height: 1.2;
  }

  .shop-subtitle {
    font-size: 1.1rem;
    opacity: 0.8;
    margin: 0;
  }

  @media (max-width: 768px) {
    .shop-gallery {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .shop-image-wrapper {
      height: 300px;
    }
    .shop-title {
      font-size: 1.8rem;
    }
  }
</style>
