---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from "@app/layouts/Layout.astro";
import { shopItems } from "../../../data/content";
import ShopImage from '@shared/ui/ShopImage/ShopImage.astro';

export function getStaticPaths() {
  const langs = ["ru", "en"];
  return langs.flatMap((lang) =>
    shopItems.map((item) => ({
      params: { lang, slug: item.slug },
      props: { item },
    })),
  );
}

const { lang } = Astro.params;
const { item } = Astro.props;

const t = useTranslations(lang as Lang);
---

<Layout
  title={`${item.title[lang as "ru" | "en"]} | Egg Culture`}
  description={item.shortDescription[lang as "ru" | "en"]}
  ogImage={item.image}
  lang={lang as string}
>
  <div
    class="container shop-container"
    style="padding-top: 3rem; padding-bottom: 4rem;"
  >
    <a href={`/${lang}/shop`} class="back-link">
      ← {lang === "ru" ? "Назад в Бутик" : "Back to Boutique"}
    </a>

    <article class="shop-detail">
      <div class="shop-image-wrapper">
        <ShopImage
          src={item.image}
          alt={item.title[lang as "ru" | "en"]}
          lang={lang as string}
          eager
          priority
          sizes="(max-width: 768px) min(30rem, calc(100vw - 2rem)), 480px"
        />
      </div>
      <header class="shop-header">
        <h1 class="shop-title">{item.title[lang as "ru" | "en"]}</h1>
        <p class="shop-price">{item.price}</p>
      </header>

      <div class="shop-content">
        <p>{item.description[lang as "ru" | "en"]}</p>
        <h2 class="shop-specifications-title">{lang === "ru" ? "Характеристики" : "Specifications"}</h2>
        <dl class="shop-specifications">
          {item.specifications.map((specification) => (
            <div>
              <dt>{specification.label[lang as "ru" | "en"]}</dt>
              <dd>{specification.value[lang as "ru" | "en"]}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="shop-action">
        <a
          href="https://t.me/+QIepC6ildbdmMDBi"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
        >
          {lang === "ru" ? "Заказать в Telegram" : "Order via Telegram"}
        </a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .shop-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    padding-bottom: 2rem;
    font-family: var(--font-sans-ui);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    opacity: 0.6;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
    text-decoration: none;
  }

  .back-link:hover {
    opacity: 1;
    color: var(--color-yolk-text);
  }

  .shop-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "image header"
      "image content"
      "image action";
    align-items: start;
    gap: 1.5rem 2.5rem;
    border: 1px solid rgba(43, 43, 43, 0.1);
    background-color: rgba(255, 255, 255, 0.5);
    padding: 2rem;
  }

  .shop-image-wrapper {
    grid-area: image;
    width: 100%;
    aspect-ratio: 1;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .shop-header {
    grid-area: header;
    border-bottom: 1px solid rgba(43, 43, 43, 0.1);
    padding-bottom: 1.5rem;
  }

  .shop-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    color: var(--color-yolk-text);
    line-height: 1.2;
    padding: 0 0 1rem 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .shop-price {
    font-family: var(--font-sans-ui);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .shop-content {
    grid-area: content;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .shop-content p {
    margin: 0;
  }

  .shop-specifications-title {
    margin: 1.75rem 0 0.75rem;
    padding: 0;
    font-size: 1.25rem;
  }

  .shop-specifications {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .shop-specifications > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid rgba(43, 43, 43, 0.12);
  }

  .shop-specifications dt {
    font-weight: 600;
  }

  .shop-specifications dd {
    margin: 0;
  }

  .shop-specifications dt,
  .shop-specifications dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .shop-action {
    grid-area: action;
  }

  @media (max-width: 768px) {
    .shop-detail {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "image" "header" "content" "action";
      padding: 1.25rem;
    }
    .shop-image-wrapper { max-width: 30rem; justify-self: center; }
    .shop-header, .shop-action { text-align: center; }
    .shop-title { font-size: clamp(1.8rem, 8vw, 2.4rem); overflow-wrap: anywhere; }
    .shop-content { font-size: 1rem; }
  }
</style>
