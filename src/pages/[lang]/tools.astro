---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import EggCalculator from '@features/EggCalculator/EggCalculator';
import EggOracle from '@features/EggOracle/EggOracle';
import DescriptorWheel from '@widgets/DescriptorWheel/DescriptorWheel.jsx';
import TastingNoteGenerator from '@features/TastingNote/TastingNoteGenerator';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout
  title={t("tools.pageTitle")}
  description={t("tools.metaDescription")}
  lang={lang as string}
>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 3rem; padding-bottom: 3rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{t("tools.title")}</h1>
      <p class="text-lead">{t("tools.subtitle")}</p>
    </div>

    <div>
      <EggCalculator client:only="react" dict={t("calculator")} />
    </div>

    <div>
      <EggOracle client:only="react" dict={t("oracle")} />
      <p class="text-center" style="margin-top: 1.5rem;">
        <a href={`/${lang}/prophecy`} class="prophecy-link">
          {lang === "ru"
            ? "Ежедневное пророчество желтка →"
            : "The daily prophecy of the yolk →"}
        </a>
      </p>
    </div>

    <div>
      <div class="text-center flex-col gap-md" style="margin-bottom: 2rem;">
        <h2>{t("tools.noteGenTitle")}</h2>
        <p>{t("tools.noteGenDesc")}</p>
      </div>
      <TastingNoteGenerator client:visible lang={lang as Lang} />
    </div>

    <div>
      <div class="text-center flex-col gap-md" style="margin-bottom: 2rem;">
        <h2>{t("tools.wheelTitle")}</h2>
        <p>{t("tools.wheelDesc")}</p>
      </div>
      <DescriptorWheel client:load />
    </div>

    <div class="text-center flex-col gap-md persona-teaser">
      <h2>{t("tools.personaTitle")}</h2>
      <p>{t("tools.personaDesc")}</p>
      <p>
        <a href={`/${lang}/egg-type`} class="btn">{t("tools.personaCta")}</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk);
    padding-bottom: 2rem;
    margin: 0;
  }

  .persona-teaser {
    padding: var(--spacing-xl);
    border: 1px dashed var(--color-yolk);
    background: rgba(212, 175, 55, 0.06);
  }

  .prophecy-link {
    font-style: italic;
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }

  .prophecy-link:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
      padding-bottom: 1rem;
    }
  }
</style>
