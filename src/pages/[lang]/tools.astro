---
import { useTranslations, type Lang } from '@shared/i18n/utils';
import Layout from '@app/layouts/Layout.astro';
import EggCalculator from '@features/EggCalculator/EggCalculator';
import EggOracle from '@features/EggOracle/EggOracle';
import DescriptorWheel from '@widgets/DescriptorWheel/DescriptorWheel.jsx';
import TastingNoteGenerator from '@features/TastingNote/TastingNoteGenerator';

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
const toolLinks = [
  { id: 'calculator', label: lang === 'ru' ? 'Расчёт варки' : 'Boiling time' },
  { id: 'oracle', label: lang === 'ru' ? 'Оракул' : 'Oracle' },
  { id: 'tasting-note', label: lang === 'ru' ? 'Дегустационная заметка' : 'Tasting note' },
  { id: 'descriptors', label: lang === 'ru' ? 'Колесо дескрипторов' : 'Descriptor wheel' },
  { id: 'egg-persona', label: lang === 'ru' ? 'Какое вы яйцо?' : 'Which egg are you?' },
];
---

<Layout
  title={t("tools.pageTitle")}
  description={t("tools.metaDescription")}
  lang={lang as string}
>
  <div
    class="container flex-col gap-2xl"
    style="padding-top: 3rem; padding-bottom: 3rem;"
  >
    <div class="text-center flex-col gap-sm">
      <h1 class="page-title">{t("tools.title")}</h1>
      <p class="text-lead">{t("tools.subtitle")}</p>
    </div>

    <details class="tools-menu" open>
      <summary>{lang === 'ru' ? 'Выбрать инструмент' : 'Choose a tool'}</summary>
      <nav aria-label={lang === 'ru' ? 'Инструменты' : 'Tools'}>
        {toolLinks.map(tool => <a href={`#${tool.id}`}>{tool.label}</a>)}
      </nav>
    </details>

    <div id="calculator" class="tool-anchor" tabindex="-1">
      <EggCalculator client:load dict={t("calculator")} />
    </div>

    <div id="oracle" class="tool-anchor" tabindex="-1">
      <EggOracle client:load dict={t("oracle")} />
      <p class="text-center" style="margin-top: 1.5rem;">
        <a href={`/${lang}/prophecy`} class="btn btn-link">
          {lang === "ru"
            ? "Ежедневное пророчество желтка →"
            : "The daily prophecy of the yolk →"}
        </a>
      </p>
    </div>

    <div id="tasting-note" class="tool-anchor" tabindex="-1">
      <div class="text-center flex-col gap-md" style="margin-bottom: 2rem;">
        <h2>{t("tools.noteGenTitle")}</h2>
        <p>{t("tools.noteGenDesc")}</p>
      </div>
      <TastingNoteGenerator client:visible lang={lang as Lang} />
    </div>

    <div id="descriptors" class="tool-anchor" tabindex="-1">
      <div class="text-center flex-col gap-md" style="margin-bottom: 2rem;">
        <h2>{t("tools.wheelTitle")}</h2>
        <p>{t("tools.wheelDesc")}</p>
      </div>
      <DescriptorWheel client:load lang={lang} />
    </div>

    <div id="egg-persona" class="tool-anchor text-center flex-col gap-md persona-teaser" tabindex="-1">
      <h2>{t("tools.personaTitle")}</h2>
      <p>{t("tools.personaDesc")}</p>
      <p>
        <a href={`/${lang}/egg-type`} class="btn">{t("tools.personaCta")}</a>
      </p>
    </div>
  </div>

<script is:inline>
  (() => {
    const menu = document.querySelector('.tools-menu');
    if (!menu) return;
    const mobile = window.matchMedia('(max-width: 768px)');
    const setLayout = () => { menu.open = !mobile.matches; };
    setLayout();
    mobile.addEventListener('change', setLayout);
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      if (mobile.matches) menu.open = false;
    }));
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && mobile.matches && menu.open) {
        menu.open = false;
        menu.querySelector('summary').focus();
      }
    });
    const hash = window.location.hash;
    if (!['#calculator', '#oracle', '#tasting-note', '#descriptors', '#egg-persona'].includes(hash)) return;
    // History navigation owns its saved scroll position.
    if (performance.getEntriesByType("navigation")[0]?.type === "back_forward") return;
    const calculator = document.querySelector(".egg-calculator-container");
    const target = document.getElementById(hash.slice(1));
    if (!calculator || !target) return;

    let finished = false;
    let fontsReady = false;
    let frame = 0;
    const inputEvents = ["wheel", "touchstart", "pointerdown", "keydown"];
    const cleanup = () => {
      finished = true;
      observer.disconnect();
      window.cancelAnimationFrame(frame);
      for (const event of inputEvents) window.removeEventListener(event, cleanup, true);
      window.removeEventListener("hashchange", cleanup);
      window.removeEventListener("pagehide", cleanup);
    };
    const align = () => {
      if (finished || frame || !fontsReady || calculator.dataset.ready !== "true") return;
      observer.disconnect();
      // Wait for the restored timer and the final font metrics to reach layout.
      frame = window.requestAnimationFrame(() => {
        if (!finished && window.location.hash === hash) {
          target.scrollIntoView({ block: "start", behavior: "instant" });
        }
        cleanup();
      });
    };
    const observer = new MutationObserver(align);
    observer.observe(calculator, { attributes: true, attributeFilter: ["data-ready"] });
    // Once the visitor interacts, never pull them back to the initial anchor.
    for (const event of inputEvents) window.addEventListener(event, cleanup, { capture: true, passive: true });
    window.addEventListener("hashchange", cleanup);
    window.addEventListener("pagehide", cleanup);
    (document.fonts?.ready ?? Promise.resolve()).then(() => {
      fontsReady = true;
      align();
    });
  })();
</script>
</Layout>

<style>
  .page-title {
    font-size: 3.5rem;
    color: var(--color-yolk-text);
    padding-bottom: 2rem;
    margin: 0;
  }

  .persona-teaser {
    padding: var(--spacing-xl);
    border: 1px dashed var(--color-yolk);
    background: rgba(212, 175, 55, 0.06);
  }

  .tools-menu {
    border-block: 1px solid var(--color-gray-light);
  }
  .tools-menu summary { display: none; min-height: 48px; padding: .75rem 0; font: 600 1rem/1.5 var(--font-sans-ui); color: var(--color-yolk-text); cursor: pointer; }
  .tools-menu nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem 1.5rem; padding: .75rem 0; }
  .tools-menu a { display: flex; align-items: center; min-height: 44px; font: 500 1rem/1.5 var(--font-sans-ui); color: var(--color-yolk-text); text-decoration: underline; text-underline-offset: .25em; }
  .tools-menu :is(a, summary):focus-visible { outline: 2px solid var(--color-yolk-text); outline-offset: 4px; }
  .tool-anchor:focus { outline: none; }
  .tool-anchor:focus-visible { outline: 2px solid var(--color-yolk-text); outline-offset: 6px; }
  @media (max-width: 768px) {
    .tools-menu summary { display: list-item; }
    .tools-menu nav { flex-direction: column; align-items: stretch; padding-top: 0; }
  }

  .tool-anchor {
    scroll-margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
      padding-bottom: 1rem;
    }
  }
</style>
