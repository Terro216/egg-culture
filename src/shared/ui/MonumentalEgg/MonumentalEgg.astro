---
// MonumentalEgg.astro
---

<div class="egg-container" id="monumental-egg-container" aria-hidden="true"><div class="egg-fallback"></div></div>

<style>
  .egg-container {
    width: 100%;
    height: 35vh;
    min-height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .egg-fallback { height: 75%; aspect-ratio: .68; border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%; background: radial-gradient(ellipse at 35% 30%, #fffdf6 10%, #f3eddd 60%, #d8cdb5 100%); box-shadow: inset -10px -8px 26px #a5967417, 0 14px 30px #6a572817; }
  .egg-container.has-webgl .egg-fallback { display: none; }
</style>

<script>
  import * as THREE from "three";
  import { animateDecoration } from "@shared/utils/decorativeAnimation";

  let cleanup = () => {};

  function init() {
    cleanup();
    const container = document.getElementById("monumental-egg-container");
    if (!container) return;

    // Remove any existing canvas if script re-runs (HMR)
    container.querySelector("canvas")?.remove();
    container.classList.remove("has-webgl");

    const scene = new THREE.Scene();

    // Setup camera
    const camera = new THREE.PerspectiveCamera(
      45,
      container.clientWidth / container.clientHeight,
      0.1,
      100,
    );
    camera.position.z = 12;

    // Setup renderer with transparent background to blend into the site's palette
    let renderer: THREE.WebGLRenderer;
    try { renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true }); }
    catch { return; }
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.appendChild(renderer.domElement);
    container.classList.add("has-webgl");

    // Create Egg Geometry
    // We start with a sphere and deform its vertices to form an elegant egg shape
    const geometry = new THREE.SphereGeometry(2, 64, 64);
    const positions = geometry.attributes.position;
    for (let i = 0; i < positions.count; i++) {
      const y = positions.getY(i);
      // Deform the sphere: narrower at the top, wider at the bottom
      // The y value ranges from -2 to 2
      const scale = 1 - y * 0.12;
      positions.setX(i, positions.getX(i) * scale);
      positions.setZ(i, positions.getZ(i) * scale);
      positions.setY(i, y * 1.55); // stretch it vertically to look like a real egg
    }
    geometry.computeVertexNormals(); // Fix lighting after deformation

    // Fine shell relief: a small deterministic texture, with no image download.
    const grain = new Uint8Array(128 * 128 * 4);
    let seed = 17;
    for (let i = 0; i < grain.length; i += 4) {
      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
      const value = 112 + (seed >>> 27);
      grain[i] = grain[i + 1] = grain[i + 2] = value;
      grain[i + 3] = 255;
    }
    const shellRelief = new THREE.DataTexture(grain, 128, 128, THREE.RGBAFormat);
    shellRelief.wrapS = shellRelief.wrapT = THREE.RepeatWrapping;
    shellRelief.repeat.set(6, 9);
    shellRelief.magFilter = THREE.LinearFilter;
    shellRelief.minFilter = THREE.LinearMipmapLinearFilter;
    shellRelief.generateMipmaps = true;
    shellRelief.needsUpdate = true;

    const material = new THREE.MeshPhysicalMaterial({
      color: 0xfff9ed,
      roughness: 0.72,
      metalness: 0,
      clearcoat: 0.03,
      clearcoatRoughness: 0.65,
      bumpMap: shellRelief,
      bumpScale: 0.025,
    });

    const egg = new THREE.Mesh(geometry, material);
    scene.add(egg);

    // Warm diffuse fill keeps the lower shell light while retaining its volume.
    const ambientLight = new THREE.HemisphereLight(0xfffcf4, 0xd8c8ac, 1.8);
    scene.add(ambientLight);

    const mainLight = new THREE.DirectionalLight(0xfffcf5, 2.5);
    mainLight.position.set(5, 10, 7);
    scene.add(mainLight);

    const goldLight = new THREE.DirectionalLight(0xf0dfb5, 0.35);
    goldLight.position.set(-5, -3, -5);
    scene.add(goldLight);

    // Resize handler
    const onWindowResize = () => {
      if (!container) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    };
    window.addEventListener("resize", onWindowResize);

    // Animation loop
    const stop = animateDecoration(container, (elapsedTime) => {

      // Slow, majestic rotation (the Kubrick monolith feel)
      // Slight tilt on X and Z makes the rotation around Y much more visible
      egg.rotation.y = elapsedTime * 0.2;
      egg.rotation.z = 0.15;
      egg.rotation.x = 0.1;

      // Extremely subtle levitation
      egg.position.y = Math.sin(elapsedTime * 0.5) * 0.15;

      renderer.render(scene, camera);
    });
    const lost = (event: Event) => { event.preventDefault(); stop(); container.classList.remove("has-webgl"); renderer.domElement.hidden = true; };
    renderer.domElement.addEventListener("webglcontextlost", lost);
    renderer.domElement.addEventListener("webglcontextrestored", init);
    cleanup = () => { stop(); window.removeEventListener("resize", onWindowResize); renderer.domElement.removeEventListener("webglcontextlost", lost); renderer.domElement.removeEventListener("webglcontextrestored", init); geometry.dispose(); material.dispose(); shellRelief.dispose(); renderer.dispose(); renderer.domElement.remove(); container.classList.remove("has-webgl"); };
  }

  // Initialize on mount
  init();

  // Re-initialize if Astro view transitions are used
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => cleanup());
</script>
