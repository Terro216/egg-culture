---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@shared/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const ruUrl = currentPath.replace(new RegExp(`^/${lang}`), "/ru") + Astro.url.search;
const enUrl = currentPath.replace(new RegExp(`^/${lang}`), "/en") + Astro.url.search;
---

<header class="site-header">
  <div class="container header-container">
    <a href={translatePath("/")} class="logo">{t("home.heroTitle")}</a>
    <button class="nav-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" hidden>{lang === "ru" ? "Меню" : "Menu"}</button>
    <nav class="main-nav" id="main-navigation" aria-label={lang === "ru" ? "Главная навигация" : "Main navigation"}>
      <a href={translatePath("/manifesto")}>{t("nav.manifesto")}</a>
      <a href={translatePath("/guide")}>{t("nav.guide")}</a>
      <a href={translatePath("/tools")}>{t("nav.tools")}</a>
      <a href={translatePath("/incubator")}>{t("nav.incubator")}</a>
      <a href={translatePath("/kladka")}>{t("nav.kladka")}</a>
      <a href={translatePath("/shop")}>{t("nav.shop")}</a>
      <a href={translatePath("/blog")}>{t("nav.blog")}</a>
      <a href={translatePath("/events")}>{t("nav.events")}</a>
      <a href={`/${lang}/profile/`}>{lang === "ru" ? "Профиль" : "Profile"}</a>
      <a href={`/${lang}/quiz`} class="secret-key" aria-label={lang === "ru" ? "Инициация" : "Initiation"}>🗝️</a>
      <div class="lang-switcher">
        <a href={ruUrl} data-language="ru" lang="ru" aria-label="Русский" aria-current={lang === "ru" ? "true" : undefined} class={lang === "ru" ? "active" : ""}>RU</a>
        <a href={enUrl} data-language="en" lang="en" aria-label="English" aria-current={lang === "en" ? "true" : undefined} class={lang === "en" ? "active" : ""}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
  if (header && toggle) {
    toggle.hidden = false;
    header.dataset.menuReady = "true";
    const close = () => toggle.setAttribute("aria-expanded", "false");
    toggle.addEventListener("click", () => toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true")));
    header.addEventListener("keydown", event => { if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { close(); toggle.focus(); } });
    header.querySelectorAll<HTMLAnchorElement>("a[data-language]").forEach(link => {
      const update = () => { const url = new URL(location.href); url.pathname = url.pathname.replace(/^\/(ru|en)(?=\/|$)/, `/${link.dataset.language}`); link.href = url.href; };
      update();
      link.addEventListener("pointerdown", update);
      link.addEventListener("focus", update);
      link.addEventListener("click", update);
      window.addEventListener("hashchange", update);
    });
  }
</script>

<style>
  .site-header {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border-color, rgba(43, 43, 43, 0.1));
  }

  .header-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-serif-headers, 'Playfair Display', serif);
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .main-nav {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: 0.5rem clamp(0.75rem, 2vw, 1.5rem);
    align-items: center;
  }

  .main-nav a {
    flex-shrink: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: 1.1rem;
    text-transform: lowercase;
    letter-spacing: 0.05em;
  }

  .nav-toggle { display: none; }
  .secret-key, .lang-switcher a { min-width: 44px; justify-content: center; }
  .main-nav a:focus-visible, .nav-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  .secret-key {
    opacity: 0.7;
    font-size: 1.2rem !important;
    transition: opacity 0.3s ease;
    text-decoration: none;
  }

  .secret-key:hover {
    opacity: 1;
  }

  .lang-switcher {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .lang-switcher a {
    font-size: 1.2rem;
    opacity: 0.5;
    transition: opacity 0.3s;
    text-transform: none;
    letter-spacing: normal;
  }

  .lang-switcher a.active,
  .lang-switcher a:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 1rem 0;
    }

    .header-container {
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;
    }

    .logo {
      font-size: clamp(1rem, 4.5vw, 1.5rem);
      max-width: calc(100% - 75px);
    }

    .nav-toggle:not([hidden]) { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 6px 10px; border: 1px solid currentColor; border-radius: 6px; font-size: 14px; }
    .site-header[data-menu-ready] .nav-toggle[aria-expanded="false"] + .main-nav { display: none; }

    .main-nav {
      gap: 1rem;
      justify-content: center;
      width: 100%;
    }

    .main-nav a {
      font-size: 1rem;
    }

    .lang-switcher {
      margin-left: 0;
      justify-content: center;
      width: 100%;
    }
  }
</style>
